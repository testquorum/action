{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions", "npm"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^action/version\\.ts$/",
        "/^dist/index\\.js$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+packageName=(?<packageName>\\S+)\\s+currentValue=(?<currentValue>\\S+)\\s*\\n(?:export )?const PINNED_VERSION = \"(?<currentDigest>[a-f0-9]{40})\""
      ]
    }
  ],
  "rebaseWhen": "behind-base-branch",
  "schedule": ["after 11pm on Monday"]
}
